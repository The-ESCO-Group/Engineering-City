{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESCO Engineering City",
  "version": "0.1.0",
  "identifier": "com.escogroup.engineeringcity",
  "build": {
    "beforeDevCommand": "npm --prefix ../../frontend run dev",
    "devUrl": "http://127.0.0.1:4173",
    "beforeBuildCommand": "npm --prefix ../../frontend run build",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [{"title":"ESCO Engineering City","width":1440,"height":900,"minWidth":1180,"minHeight":720}],
    "security": {"csp":"default-src 'self'; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'; img-src 'self' data:"}
  },
  "bundle": {"active":true,"targets":["nsis","msi"],"windows":{"webviewInstallMode":{"type":"embedBootstrapper"}}}
}

