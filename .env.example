# ESCO Engineering City - backend configuration
#
# Copy to .env and edit. Every variable is optional; the defaults below give a
# working offline demo (SQLite + MockProvider) with no external service.
#
# NEVER commit a filled-in .env. Secrets belong in the local file only.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ESCO_ENVIRONMENT=demo            # demo | development | production | test
ESCO_DEBUG=false
ESCO_LOG_LEVEL=INFO
ESCO_LOG_JSON=true

# Browser origins allowed to call the API (comma-separated).
ESCO_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:1420

# This product is local-only. Leave false unless you have deliberately decided
# to expose the API beyond loopback and have secured it accordingly.
ESCO_ALLOW_REMOTE_BINDING=false

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Demonstration mode (default): a single SQLite file.
ESCO_DATABASE_URL=sqlite+pysqlite:///./data/esco_city.sqlite3
# Internal multi-user deployment: PostgreSQL. Requires the `postgres` extra:
#   pip install -e ".[postgres]"
# ESCO_DATABASE_URL=postgresql+psycopg://esco:CHANGE_ME@localhost:5432/esco_city
ESCO_DATABASE_ECHO=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
ESCO_DATA_DIR=./data
ESCO_MAX_UPLOAD_BYTES=209715200          # 200 MiB per file
ESCO_MAX_PROJECT_BYTES=5368709120        # 5 GiB per project

# Archive safety (zip-bomb and traversal guards)
ESCO_MAX_ARCHIVE_ENTRIES=5000
ESCO_MAX_ARCHIVE_UNCOMPRESSED_BYTES=2147483648
ESCO_MAX_ARCHIVE_COMPRESSION_RATIO=200
ESCO_MAX_ARCHIVE_DEPTH=2

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# MUST be replaced outside demo/development. The app refuses to start in
# production with the default value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
ESCO_JWT_SECRET=dev-only-insecure-secret-change-me
ESCO_ACCESS_TOKEN_TTL_SECONDS=43200
ESCO_SESSION_COOKIE_SECURE=false         # true when served over HTTPS

# Seeded on first boot so a fresh demo is usable. Change both in production.
ESCO_BOOTSTRAP_ADMIN_EMAIL=admin@esco.internal
ESCO_BOOTSTRAP_ADMIN_PASSWORD=esco-demo-admin
ESCO_BOOTSTRAP_DEMO_USERS=true

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Only providers listed here may be used. `mock` is always available and is the
# only one required for the offline demo and the test suite.
#
# External providers are OFF by default. Enabling one is an explicit
# administrator decision and sends project content to a third party.
ESCO_ENABLED_PROVIDERS=mock
ESCO_DEFAULT_PROVIDER=mock

# Local models via Ollama (stays on this machine):
# ESCO_ENABLED_PROVIDERS=mock,ollama
# ESCO_DEFAULT_PROVIDER=ollama
ESCO_OLLAMA_BASE_URL=http://127.0.0.1:11434
ESCO_OLLAMA_MODEL=llama3.1:8b

# OpenAI - sends project content off this machine. Requires a key.
# ESCO_ENABLED_PROVIDERS=mock,openai
# ESCO_OPENAI_API_KEY=
# ESCO_OPENAI_MODEL=gpt-4o-mini

# Anthropic - sends project content off this machine. Requires a key.
# ESCO_ENABLED_PROVIDERS=mock,anthropic
# ESCO_ANTHROPIC_API_KEY=
# ESCO_ANTHROPIC_MODEL=claude-sonnet-5

ESCO_PROVIDER_TIMEOUT_SECONDS=120
ESCO_PROVIDER_MAX_RETRIES=3

# ---------------------------------------------------------------------------
# Agent run limits
# ---------------------------------------------------------------------------
ESCO_AGENT_RUN_TIMEOUT_SECONDS=300
ESCO_AGENT_MAX_ACTIONS_PER_RUN=50
ESCO_AGENT_MAX_ITERATIONS_PER_RUN=8
ESCO_AGENT_MAX_TOKENS_PER_RUN=200000
ESCO_PROJECT_TOKEN_BUDGET=2000000
ESCO_PROJECT_COST_BUDGET_USD=25

# ---------------------------------------------------------------------------
# Worker / workflow engine
# ---------------------------------------------------------------------------
ESCO_WORKER_ENABLED=true
ESCO_WORKER_CONCURRENCY=2
ESCO_WORKER_POLL_INTERVAL_SECONDS=0.5
ESCO_TASK_MAX_ATTEMPTS=3
ESCO_TASK_LEASE_SECONDS=900

# ---------------------------------------------------------------------------
# Events / WebSocket
# ---------------------------------------------------------------------------
ESCO_WS_REPLAY_LIMIT=500
