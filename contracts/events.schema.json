{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://esco.local/contracts/events.schema.json",
  "title": "ESCO Engineering City event contract",
  "description": "Envelope and payload shapes for events broadcast on WebSocket /ws/projects/{project_id}. Every event is persisted before it is broadcast, and `seq` is gap-free per project so a reconnecting client can replay with ?since_seq=. Generated from the backend models; do not edit by hand.",
  "x-contract-version": "1.0.0",
  "x-schema-version": 1,
  "x-payload-by-event-type": {
    "agent.location_changed": "#/$defs/AgentLocationEventPayload",
    "agent.message_created": "#/$defs/AgentMessageEventPayload",
    "agent.status_changed": "#/$defs/AgentStatusEventPayload",
    "approval.decided": "#/$defs/ApprovalEventPayload",
    "approval.requested": "#/$defs/ApprovalEventPayload",
    "file.deleted": "#/$defs/FileEventPayload",
    "file.parse_failed": "#/$defs/FileEventPayload",
    "file.parsed": "#/$defs/FileEventPayload",
    "file.parsing_started": "#/$defs/FileEventPayload",
    "file.uploaded": "#/$defs/FileEventPayload",
    "finding.created": "#/$defs/FindingEventPayload",
    "finding.reviewed": "#/$defs/FindingEventPayload",
    "finding.updated": "#/$defs/FindingEventPayload",
    "project.completed": "#/$defs/ProjectEventPayload",
    "project.created": "#/$defs/ProjectEventPayload",
    "project.failed": "#/$defs/ProjectEventPayload",
    "project.updated": "#/$defs/ProjectEventPayload",
    "report.created": "#/$defs/ReportEventPayload",
    "task.blocked": "#/$defs/TaskEventPayload",
    "task.completed": "#/$defs/TaskEventPayload",
    "task.created": "#/$defs/TaskEventPayload",
    "task.failed": "#/$defs/TaskEventPayload",
    "task.started": "#/$defs/TaskEventPayload",
    "workflow.cancelled": "#/$defs/WorkflowEventPayload",
    "workflow.paused": "#/$defs/WorkflowEventPayload",
    "workflow.resumed": "#/$defs/WorkflowEventPayload",
    "workflow.started": "#/$defs/WorkflowEventPayload"
  },
  "$ref": "#/$defs/EventEnvelope",
  "$defs": {
    "AgentLocationEventPayload": {
      "properties": {
        "agent_id": {
          "format": "uuid",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_kind": {
          "title": "Agent Kind",
          "type": "string"
        },
        "location": {
          "title": "Location",
          "type": "string"
        },
        "previous_location": {
          "default": "",
          "title": "Previous Location",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "agent_kind",
        "location"
      ],
      "title": "AgentLocationEventPayload",
      "type": "object"
    },
    "AgentMessageEventPayload": {
      "properties": {
        "message_id": {
          "format": "uuid",
          "title": "Message Id",
          "type": "string"
        },
        "agent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Agent Id"
        },
        "agent_kind": {
          "default": "",
          "title": "Agent Kind",
          "type": "string"
        },
        "role": {
          "title": "Role",
          "type": "string"
        },
        "body": {
          "title": "Body",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "message_id",
        "role",
        "body"
      ],
      "title": "AgentMessageEventPayload",
      "type": "object"
    },
    "AgentStatusEventPayload": {
      "properties": {
        "agent_id": {
          "format": "uuid",
          "title": "Agent Id",
          "type": "string"
        },
        "agent_kind": {
          "title": "Agent Kind",
          "type": "string"
        },
        "display_name": {
          "title": "Display Name",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "current_activity": {
          "default": "",
          "title": "Current Activity",
          "type": "string"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        }
      },
      "required": [
        "agent_id",
        "agent_kind",
        "display_name",
        "status"
      ],
      "title": "AgentStatusEventPayload",
      "type": "object"
    },
    "ApprovalEventPayload": {
      "properties": {
        "approval_id": {
          "format": "uuid",
          "title": "Approval Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "finding_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finding Id"
        },
        "recommendation_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Recommendation Id"
        },
        "decided_by_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Decided By Id"
        }
      },
      "required": [
        "approval_id",
        "kind",
        "status",
        "title"
      ],
      "title": "ApprovalEventPayload",
      "type": "object"
    },
    "EventEnvelope": {
      "description": "One entry in a project's ordered event stream.",
      "properties": {
        "id": {
          "format": "uuid",
          "title": "Id",
          "type": "string"
        },
        "schema_version": {
          "description": "Envelope version. Bumped only on a breaking payload change.",
          "title": "Schema Version",
          "type": "integer"
        },
        "seq": {
          "description": "Gap-free per-project sequence number. Reconnecting clients pass the last value they saw as ?since_seq= to replay what they missed.",
          "title": "Seq",
          "type": "integer"
        },
        "event_type": {
          "$ref": "#/$defs/EventType"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "agent_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Agent instance that caused the event, if any.",
          "title": "Agent Id"
        },
        "task_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Task Id"
        },
        "actor_user_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Authenticated human that caused the event, if any.",
          "title": "Actor User Id"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "payload": {
          "additionalProperties": true,
          "title": "Payload",
          "type": "object"
        }
      },
      "required": [
        "id",
        "schema_version",
        "seq",
        "event_type",
        "project_id",
        "occurred_at"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "EventType": {
      "description": "Event types broadcast over the project WebSocket.\n\nPersisted before broadcast; see ``contracts/events.schema.json``.",
      "enum": [
        "project.created",
        "project.updated",
        "project.completed",
        "project.failed",
        "file.uploaded",
        "file.parsing_started",
        "file.parsed",
        "file.parse_failed",
        "file.deleted",
        "workflow.started",
        "workflow.paused",
        "workflow.resumed",
        "workflow.cancelled",
        "task.created",
        "task.started",
        "task.completed",
        "task.failed",
        "task.blocked",
        "agent.status_changed",
        "agent.location_changed",
        "agent.message_created",
        "finding.created",
        "finding.reviewed",
        "finding.updated",
        "approval.requested",
        "approval.decided",
        "report.created"
      ],
      "title": "EventType",
      "type": "string"
    },
    "FileEventPayload": {
      "properties": {
        "file_id": {
          "format": "uuid",
          "title": "File Id",
          "type": "string"
        },
        "original_filename": {
          "title": "Original Filename",
          "type": "string"
        },
        "file_kind": {
          "title": "File Kind",
          "type": "string"
        },
        "document_role": {
          "title": "Document Role",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "size_bytes": {
          "default": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "sha256": {
          "default": "",
          "title": "Sha256",
          "type": "string"
        },
        "warning_count": {
          "default": 0,
          "title": "Warning Count",
          "type": "integer"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "file_id",
        "original_filename",
        "file_kind",
        "document_role",
        "status"
      ],
      "title": "FileEventPayload",
      "type": "object"
    },
    "FindingEventPayload": {
      "properties": {
        "finding_id": {
          "format": "uuid",
          "title": "Finding Id",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "category": {
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "title": "Severity",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "confidence": {
          "title": "Confidence",
          "type": "number"
        },
        "requires_approval": {
          "title": "Requires Approval",
          "type": "boolean"
        },
        "evidence_count": {
          "default": 0,
          "title": "Evidence Count",
          "type": "integer"
        },
        "created_by_agent_kind": {
          "default": "",
          "title": "Created By Agent Kind",
          "type": "string"
        },
        "review_verdict": {
          "default": "",
          "title": "Review Verdict",
          "type": "string"
        }
      },
      "required": [
        "finding_id",
        "title",
        "category",
        "severity",
        "status",
        "confidence",
        "requires_approval"
      ],
      "title": "FindingEventPayload",
      "type": "object"
    },
    "ProjectEventPayload": {
      "properties": {
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "failure_reason": {
          "default": "",
          "title": "Failure Reason",
          "type": "string"
        }
      },
      "required": [
        "project_id",
        "name",
        "status"
      ],
      "title": "ProjectEventPayload",
      "type": "object"
    },
    "ReportEventPayload": {
      "properties": {
        "report_id": {
          "format": "uuid",
          "title": "Report Id",
          "type": "string"
        },
        "report_type": {
          "title": "Report Type",
          "type": "string"
        },
        "export_format": {
          "title": "Export Format",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "provider_name": {
          "default": "",
          "title": "Provider Name",
          "type": "string"
        }
      },
      "required": [
        "report_id",
        "report_type",
        "export_format",
        "title",
        "status"
      ],
      "title": "ReportEventPayload",
      "type": "object"
    },
    "TaskEventPayload": {
      "properties": {
        "task_id": {
          "format": "uuid",
          "title": "Task Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        },
        "status": {
          "title": "Status",
          "type": "string"
        },
        "agent_kind": {
          "default": "",
          "title": "Agent Kind",
          "type": "string"
        },
        "attempts": {
          "default": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "detail": {
          "default": "",
          "title": "Detail",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "kind",
        "title",
        "status"
      ],
      "title": "TaskEventPayload",
      "type": "object"
    },
    "WebSocketError": {
      "description": "Terminal frame sent before the server closes a WebSocket.",
      "properties": {
        "type": {
          "default": "error",
          "title": "Type",
          "type": "string"
        },
        "code": {
          "title": "Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "WebSocketError",
      "type": "object"
    },
    "WebSocketHello": {
      "description": "First frame the server sends after a WebSocket connection is accepted.",
      "properties": {
        "type": {
          "default": "hello",
          "title": "Type",
          "type": "string"
        },
        "project_id": {
          "format": "uuid",
          "title": "Project Id",
          "type": "string"
        },
        "schema_version": {
          "title": "Schema Version",
          "type": "integer"
        },
        "current_seq": {
          "title": "Current Seq",
          "type": "integer"
        },
        "replay_truncated": {
          "default": false,
          "title": "Replay Truncated",
          "type": "boolean"
        },
        "replayed": {
          "default": 0,
          "title": "Replayed",
          "type": "integer"
        }
      },
      "required": [
        "project_id",
        "schema_version",
        "current_seq"
      ],
      "title": "WebSocketHello",
      "type": "object"
    },
    "WorkflowEventPayload": {
      "properties": {
        "run_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "task_count": {
          "default": 0,
          "title": "Task Count",
          "type": "integer"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        }
      },
      "title": "WorkflowEventPayload",
      "type": "object"
    }
  }
}
