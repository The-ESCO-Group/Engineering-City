    <Tag Name="ALM_MTR401_FAULT" TagType="Base" DataType="BOOL" Radix="Decimal"
        Constant="false" ExternalAccess="Read/Write">
      <Description><![CDATA[Alarm: CV401 drive fault.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
    <Tag Name="ALM_MTR402_FAULT" TagType="Base" DataType="BOOL" Radix="Decimal"
        Constant="false" ExternalAccess="Read/Write">
      <Description><![CDATA[Alarm: CV402 drive fault.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
    <Tag Name="ALM_MTR403_FAULT" TagType="Base" DataType="BOOL" Radix="Decimal"
        Constant="false" ExternalAccess="Read/Write">
      <Description><![CDATA[Alarm: CV403 drive fault.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
    <Tag Name="ALM_CYL402_FAIL" TagType="Base" DataType="BOOL" Radix="Decimal"
        Constant="false" ExternalAccess="Read/Write">
      <Description><![CDATA[Alarm: CV404 stop gate failed to open.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
  </Tags>

  <Programs Use="Context">
    <Program Name="Line4_Control" TestEdits="false" MainRoutineName="MainRoutine"
        Disabled="false" UseAsFolder="false">
      <Description><![CDATA[Line 4 packaging conveyor control.]]></Description>
      <Tags>
        <Tag Name="ManualMode" TagType="Base" DataType="BOOL" Radix="Decimal"
            Constant="false" ExternalAccess="Read/Write">
          <Description><![CDATA[Manual mode active.]]></Description>
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
        </Tag>
        <Tag Name="AutoMode" TagType="Base" DataType="BOOL" Radix="Decimal"
            Constant="false" ExternalAccess="Read/Write">
          <Description><![CDATA[Auto mode active.]]></Description>
          <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
        </Tag>
      </Tags>
      <Routines>
        <Routine Name="MainRoutine" Type="RLL">
          <Description><![CDATA[Scheduler for the Line 4 packaging conveyors.]]></Description>
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[Mode selection first.]]></Comment>
              <Text><![CDATA[JSR(Mode_Logic,0);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[Then the permissives, which gate every run command.]]></Comment>
              <Text><![CDATA[JSR(Permissives,0);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Comment><![CDATA[Then the conveyor run logic.]]></Comment>
              <Text><![CDATA[JSR(Conveyor_Control,0);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Comment><![CDATA[Then the diverter.]]></Comment>
              <Text><![CDATA[JSR(Diverter_Control,0);]]></Text>
            </Rung>
            <Rung Number="4" Type="N">
              <Comment><![CDATA[Alarms last so they reflect this scan.]]></Comment>
              <Text><![CDATA[JSR(Alarms,0);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Mode_Logic" Type="RLL">
          <Description><![CDATA[Operating mode selection from the three-position selector.]]></Description>
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[Manual mode while the selector is in the Manual position.]]></Comment>
              <Text><![CDATA[XIC(MODE_SEL_MANUAL)XIO(MODE_SEL_AUTO)OTE(ManualMode);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[Auto mode while the selector is in the Auto position.]]></Comment>
              <Text><![CDATA[XIC(MODE_SEL_AUTO)XIO(MODE_SEL_MANUAL)OTE(AutoMode);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Permissives" Type="RLL">
          <Description><![CDATA[Master line permissive and the line start/stop seal-in.]]></Description>
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[ILK-401 emergency stop, ILK-402 divert-zone guard door and ILK-407 conveyor drive faults. ESTOP_OK and GD401_CLOSED are both de-energise-to-trip, so the permissive drops on loss of either circuit.]]></Comment>
              <Text><![CDATA[XIC(ESTOP_OK)XIC(GD401_CLOSED)XIO(MTR401_FAULT)XIO(MTR402_FAULT)XIO(MTR403_FAULT)OTE(LINE_PERMISSIVE);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[Line start/stop seal-in. STOP_PB is wired normally closed, so the seal breaks on a broken wire.]]></Comment>
              <Text><![CDATA[XIC(LINE_PERMISSIVE)XIC(STOP_PB)[XIC(START_PB),XIC(LINE_RUNNING)]OTE(LINE_RUNNING);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Conveyor_Control" Type="RLL">
          <Description><![CDATA[Run commands and speed references for CV401 to CV403, and the CV404 stop gate.]]></Description>
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[CV401 infeed run command.]]></Comment>
              <Text><![CDATA[XIC(LINE_RUNNING)XIC(LINE_PERMISSIVE)XIO(MTR401_FAULT)OTE(CV401_Run_Output);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[CV402 accumulation conveyor. Runs while PE401 sees product at the zone entry.]]></Comment>
              <Text><![CDATA[XIC(LINE_RUNNING)XIC(LINE_PERMISSIVE)XIO(MTR402_FAULT)XIC(PE401_BLOCKED)OTE(MTR402_RUN_CMD);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Comment><![CDATA[CV403 divert conveyor. A latched diverter fault stops it, per ILK-403.]]></Comment>
              <Text><![CDATA[XIC(LINE_RUNNING)XIC(LINE_PERMISSIVE)XIO(MTR403_FAULT)XIO(ALM_CYL401_FAIL)OTE(MTR403_RUN_CMD);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Comment><![CDATA[All three drives take the same line speed reference.]]></Comment>
              <Text><![CDATA[XIC(LINE_RUNNING)MOV(Line_Speed_SP,MTR401_SPEED_REF)MOV(Line_Speed_SP,MTR402_SPEED_REF)MOV(Line_Speed_SP,MTR403_SPEED_REF);]]></Text>
            </Rung>
            <Rung Number="4" Type="N">
              <Comment><![CDATA[CV404 stop gate. The gate is held open while the palletiser call is present.]]></Comment>
              <Text><![CDATA[XIC(LINE_RUNNING)XIC(LINE_PERMISSIVE)XIC(PLT_CALL)OTE(CYL402_SOL);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Diverter_Control" Type="RLL">
          <Description><![CDATA[CYL401 reject diverter: extend, confirm, fault and reset.]]></Description>
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[CYL401 extends on a reject request while the line is running and no diverter fault is latched.]]></Comment>
              <Text><![CDATA[XIC(LINE_RUNNING)XIC(LINE_PERMISSIVE)XIC(REJECT_REQ)XIO(ALM_CYL401_FAIL)OTE(CYL401_SOL);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[ILK-403 the diverter must confirm extension within 1.5 s of the solenoid being energised.]]></Comment>
              <Text><![CDATA[XIC(CYL401_SOL)XIO(CYL401_EXT_PROX)TON(CYL401_Extend_TMR,1500,0);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Comment><![CDATA[ILK-403 timer done latches the diverter fault, which drops the solenoid on rung 0 and stops CV403 in Conveyor_Control rung 2.]]></Comment>
              <Text><![CDATA[XIC(CYL401_Extend_TMR.DN)OTL(ALM_CYL401_FAIL);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Comment><![CDATA[ILK-403 reset. The diverter fault clears only in Manual, with the reset pushbutton, and only once the retract proximity switch confirms the diverter is home.]]></Comment>
              <Text><![CDATA[XIC(RESET_PB)XIC(ManualMode)XIC(CYL401_RET_PROX)OTU(ALM_CYL401_FAIL);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
        <Routine Name="Alarms" Type="RLL">
          <Description><![CDATA[Alarm bits for the FactoryTalk View ME terminal.]]></Description>
          <RLLContent>
            <Rung Number="0" Type="N">
              <Comment><![CDATA[ILK-401 emergency stop alarm.]]></Comment>
              <Text><![CDATA[XIO(ESTOP_OK)OTE(ALM_ESTOP);]]></Text>
            </Rung>
            <Rung Number="1" Type="N">
              <Comment><![CDATA[ILK-402 divert-zone guard door alarm.]]></Comment>
              <Text><![CDATA[XIO(GD401_CLOSED)OTE(ALM_GD401_OPEN);]]></Text>
            </Rung>
            <Rung Number="2" Type="N">
              <Comment><![CDATA[ILK-407 CV401 drive fault alarm.]]></Comment>
              <Text><![CDATA[XIC(MTR401_FAULT)OTE(ALM_MTR401_FAULT);]]></Text>
            </Rung>
            <Rung Number="3" Type="N">
              <Comment><![CDATA[ILK-407 CV402 drive fault alarm.]]></Comment>
              <Text><![CDATA[XIC(MTR402_FAULT)OTE(ALM_MTR402_FAULT);]]></Text>
            </Rung>
            <Rung Number="4" Type="N">
              <Comment><![CDATA[ILK-407 CV403 drive fault alarm.]]></Comment>
              <Text><![CDATA[XIC(MTR403_FAULT)OTE(ALM_MTR403_FAULT);]]></Text>
            </Rung>
            <Rung Number="5" Type="N">
              <Comment><![CDATA[CV404 stop gate confirmed open, for indication on the overview screen.]]></Comment>
              <Text><![CDATA[XIC(CYL402_SOL)XIC(CYL402_OPEN_PROX)OTE(CYL402_OPEN);]]></Text>
            </Rung>
          </RLLContent>
        </Routine>
      </Routines>
    </Program>
  </Programs>

  <Tasks Use="Context">
    <Task Name="MainTask" Type="CONTINUOUS" Priority="10" Watchdog="500"
        DisableUpdateOutputs="false" InhibitTask="false">
      <Description><![CDATA[Continuous task for the Line 4 packaging conveyors.]]></Description>
      <ScheduledPrograms>
        <ScheduledProgram Name="Line4_Control"/>
      </ScheduledPrograms>
    </Task>
  </Tasks>
</Controller>
</RSLogix5000Content>
