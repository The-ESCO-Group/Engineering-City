      <Description><![CDATA[CV404 stop gate confirmed open. Indication only.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
    <Tag Name="MTR401_SPEED_REF" TagType="Base" DataType="REAL" Radix="Float"
