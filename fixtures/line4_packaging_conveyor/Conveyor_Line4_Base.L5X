      <Description><![CDATA[Master permissive for every Line 4 conveyor.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
    <Tag Name="LINE_RUNNING" TagType="Base" DataType="BOOL" Radix="Decimal"
