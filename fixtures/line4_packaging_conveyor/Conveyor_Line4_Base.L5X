    <Tag Name="ALM_GD401_OPEN" TagType="Base" DataType="BOOL" Radix="Decimal"
        Constant="false" ExternalAccess="Read/Write">
      <Description><![CDATA[Alarm: divert-zone guard door open.]]></Description>
      <Data Format="Decorated"><DataValue DataType="BOOL" Radix="Decimal" Value="0"/></Data>
    </Tag>
    <Tag Name="ALM_CYL401_FAIL" TagType="Base" DataType="BOOL" Radix="Decimal"
        Constant="false" ExternalAccess="Read/Write">
