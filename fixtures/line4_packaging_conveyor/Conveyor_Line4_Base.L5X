      <Description><![CDATA[Slot 2 digital output card. Drive run commands and solenoids.]]></Description>
    </Module>
    <Module Name="AI_401" CatalogNumber="5069-IF8" Vendor="1"
        ParentModule="Local" Inhibited="false" MajorFault="false">
      <Description><![CDATA[Slot 3 analog input card. Spare; no channel is wired today.]]></Description>
    </Module>
    <Module Name="AO_401" CatalogNumber="5069-OF4" Vendor="1"
        ParentModule="Local" Inhibited="false" MajorFault="false">
      <Description><![CDATA[Slot 4 analog output card. Drive speed references.]]></Description>
    </Module>
  </Modules>

  <Tags Use="Context">
